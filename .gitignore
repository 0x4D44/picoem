target/
target_ci/
obj/
venv/
.venv/
env/
*.tmp
*.log
*.bak
# Claude Code session runtime state (scheduled_tasks.lock etc.)
/.claude/
# roms/: tracked binaries (blinky.bin, bootrom-combined.bin, lcd_demo.bin)
# are whitelisted by roms/.gitignore. Other build artefacts under roms/
# are still ignored by that file's rules.
# third_party/picogus/: firmware redistributed under GPL-2.0-or-later.
# See third_party/picogus/README.md for licensing and provenance, and
# third_party/picogus/LICENSE-PICOGUS-GPL-2.0.txt for the upstream
# license text. Binaries are committed alongside a `.patch` text file
# documenting any local modifications (see test_psram-bypass.patch).
#
# upstream/ is a local git clone of the PicoGUS source for reference
# during firmware-diff sessions — not redistributed, local-only. The
# pinned `VERSION` file + upstream URL satisfy GPL-2.0's source-pointer
# requirement.
third_party/picogus/upstream/

# samply / profiling scratch output: keep these out of git regardless of
# location so a stray run in repo root doesn't pollute commits.
bench-*.json
bench-*.json.gz
bench-*.json.syms.json

# cargo-mutants run output (per-mutant logs, missed.txt, caught.txt, etc.).
mutants.out*/

# V2 oracle-runner working dir: large per-mutant JSON catalogues, oracle
# replay logs, and per-mutant build artefacts. Local-only. See
# `wrk_journals/2026.04.29 - JRN - Mutation Testing V2 Oracle Runner.md`.
mutation/

# fuzz-runs/deadline is the runtime epoch handshake between Arthur and
# the overnight drivers — local-only operator state, not source.
fuzz-runs/deadline

# PID-qualified harness binary copies under fuzz-runs/ (e.g.
# silicon-soak.220248.exe) — copied in by the overnight drivers to
# dodge the Windows .exe lock, not source.
fuzz-runs/**/*.exe

# wrk_scratch/: throwaway analysis scripts (see memory:
# reference_windows_profiling for the workflow). Local-only.
wrk_scratch/

# wrk_debug/: scratch directory for ad-hoc diagnostic logs and one-off
# debug captures. Today's contents are all `.log` files which are also
# matched by the global `*.log` rule above; gitignoring the directory
# explicitly keeps any non-`.log` debug artefact (raw register dumps,
# memory snapshots, etc.) from being accidentally tracked.
wrk_debug/

# rustc internal-compiler-error dumps. cargo +nightly llvm-cov with
# incremental compilation has a known ICE on this workspace (set
# CARGO_INCREMENTAL=0 to avoid). The dumps drop into the repo root;
# they're diagnostic output, not source.
rustc-ice-*.txt

# Python bytecode caches from scripts/ (mutation runner, routing tests).
__pycache__/
*.pyc