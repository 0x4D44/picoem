target/
target_ci/
obj/
venv/
.venv/
env/
*.tmp
*.log
*.bak
# Claude Code session runtime state (scheduled_tasks.lock etc.)
/.claude/
# roms/: tracked binaries (blinky.bin, bootrom-combined.bin, lcd_demo.bin)
# are whitelisted by roms/.gitignore. Other build artefacts under roms/
# are still ignored by that file's rules.
# third_party/picogus/: firmware artefacts are fetched at demo time.
# Keep the VERSION pin + README in git, ignore the downloaded blobs.
third_party/picogus/*.zip
third_party/picogus/*.uf2
third_party/picogus/*.bin
third_party/picogus/*.exe
third_party/picogus/UPSTREAM_README.md
# upstream/ is a local git clone of the PicoGUS source for reference
# during firmware-diff sessions — not redistributed, local-only.
third_party/picogus/upstream/

# samply / profiling scratch output: keep these out of git regardless of
# location so a stray run in repo root doesn't pollute commits.
bench-*.json
bench-*.json.gz
bench-*.json.syms.json

# fuzz-runs/deadline is the runtime epoch handshake between Arthur and
# the overnight drivers — local-only operator state, not source.
fuzz-runs/deadline

# PID-qualified harness binary copies under fuzz-runs/ (e.g.
# silicon-soak.220248.exe) — copied in by the overnight drivers to
# dodge the Windows .exe lock, not source.
fuzz-runs/**/*.exe

# wrk_scratch/: throwaway analysis scripts (see memory:
# reference_windows_profiling for the workflow). Local-only.
wrk_scratch/