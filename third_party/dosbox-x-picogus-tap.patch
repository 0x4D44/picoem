 	switch(port - GUS_BASE) {
 		case 0x206:
 			if (myGUS.clearTCIfPollingIRQStatus) {
@@ -1605,14 +1711,25 @@ static Bitu read_gus(Bitu port,Bitu iolen) {
 }
 
 
+static int write_gus_diag_count = 0;
 static void write_gus(Bitu port,Bitu val,Bitu iolen) {
-	//	LOG_MSG("Write gus port %x val %x",port,val);
+	if (write_gus_diag_count < 5) {
