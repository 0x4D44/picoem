+/* ---------------- mdpicoem PicoGUS tap (begin) ----------------
+ *
+ * Logs every GUS port I/O to a CSV trace when PICOGUS_TAP_FILE is
+ * set in the environment. Consumed by the mdpicoem
+ * picogus_diff_rp2040 harness. OFF by default -- the GUS code path
+ * is unchanged when the env var is unset.
+ *
+ * Format: see third_party/README.md in the mdpicoem workspace.
+ */
+static FILE*   picogus_tap_fp           = NULL;
+static bool    picogus_tap_initialized  = false;
+static bool    picogus_tap_enabled      = false;
+static bool    picogus_tap_reentrant    = false;
+static uint64_t picogus_tap_last_ns     = 0;
+
+static void picogus_tap_init(void) {
+    if (picogus_tap_initialized) return;
+    picogus_tap_initialized = true;
+    const char* path = getenv("PICOGUS_TAP_FILE");
+    fprintf(stderr, "[DIAG] tap_init: PICOGUS_TAP_FILE=%s\n",
+            path ? path : "(null)");
+    fflush(stderr);
+    if (path == NULL || path[0] == '\0') {
+        picogus_tap_enabled = false;
+        return;
+    }
+    picogus_tap_fp = fopen(path, "wb");
+    if (picogus_tap_fp == NULL) {
+        fprintf(stderr, "[DIAG] tap_init: fopen('%s') FAILED errno=%d\n", path, errno);
+        fflush(stderr);
+        LOG_MSG("PicoGUS tap: fopen(\"%s\") failed, tap disabled", path);
+        picogus_tap_enabled = false;
+        return;
+    }
+    fprintf(stderr, "[DIAG] tap_init: opened '%s' successfully\n", path);
+    fflush(stderr);
+    picogus_tap_enabled = true;
+    fprintf(picogus_tap_fp, "# picogus-tap v1\n");
+    fprintf(picogus_tap_fp, "ns,port,value,kind\n");
+    fflush(picogus_tap_fp);
+    LOG_MSG("PicoGUS tap: logging GUS I/O to \"%s\"", path);
+}
+
+static uint64_t picogus_tap_now_ns(void) {
+    /* PIC_FullIndex() returns milliseconds since DOSBox-X start as
+     * a high-precision floating value. Multiply to ns and truncate.
+     * The value can step backwards across DOSBox-X pause/resume, so
+     * clamp to the last observed timestamp to preserve the Stage 4
+     * replayer's monotonicity contract. */
+    double ms = (double)PIC_FullIndex();
+    if (ms < 0.0) ms = 0.0;
+    uint64_t ns = (uint64_t)(ms * 1.0e6);
+    if (ns < picogus_tap_last_ns) ns = picogus_tap_last_ns;
+    picogus_tap_last_ns = ns;
+    return ns;
+}
+
+/* picogus_tap_log: not static -- also called from src/hardware/adlib.cpp
+ * (declared extern there). Keeps a single trace file across both buses. */
+void picogus_tap_log(const char* kind, Bitu port, Bitu val, Bitu iolen) {
+    if (!picogus_tap_initialized) picogus_tap_init();
+    if (!picogus_tap_enabled) return;
+    /* Recursion guard: read_gus recurses with iolen==1 for 16-bit
+     * reads. The outer 16-bit call logs "read16" at the recursion
+     * site and sets picogus_tap_reentrant across the recursion
+     * expression (see the read_gus hunk below), so the inner
+     * tap_log calls land here with the flag set and return early.
+     * Result: exactly one record per outermost logical access.
+     * DOSBox-X's CPU thread is single-threaded, so a plain static
+     * bool is sufficient -- no thread-local needed. */
+    if (picogus_tap_reentrant) return;
+    uint64_t ns = picogus_tap_now_ns();
+    if (iolen == 2) {
+        fprintf(picogus_tap_fp, "%llu,0x%03x,0x%04x,%s\n",
+                (unsigned long long)ns,
+                (unsigned)(port & 0xFFF),
+                (unsigned)(val & 0xFFFF),
+                kind);
+    } else {
+        fprintf(picogus_tap_fp, "%llu,0x%03x,0x%02x,%s\n",
+                (unsigned long long)ns,
+                (unsigned)(port & 0xFFF),
+                (unsigned)(val & 0xFF),
+                kind);
+    }
+    fflush(picogus_tap_fp);
+}
+/* ---------------- mdpicoem PicoGUS tap (end) ------------------ */
 using namespace std;
 
 #if defined(_MSC_VER)
@@ -1503,10 +1593,26 @@ static Bitu read_gus(Bitu port,Bitu iolen) {
 	 * See write_gus() for explanation. */
 	if (iolen == 2) {
 		if ((port - GUS_BASE) != 0x304) {
-			return (read_gus(port,1) & 0xFF) + (read_gus(port+1,1) << 8u);
+			/* mdpicoem PicoGUS tap: log the outer 16-bit read once
+			 * and suppress the two recursive 8-bit sub-reads by
+			 * holding picogus_tap_reentrant across the recursion.
+			 * Without this the inner calls would reach the tap
+			 * site below and emit spurious read8 records. */
+			picogus_tap_log("read16", port, 0, 2);
+			picogus_tap_reentrant = true;
+			Bitu _picogus_tap_r16 = (read_gus(port,1) & 0xFF) + (read_gus(port+1,1) << 8u);
+			picogus_tap_reentrant = false;
+			return _picogus_tap_r16;
 		}
