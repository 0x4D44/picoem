 static Adlib::Module * module = nullptr;
 
+/* mdpicoem PicoGUS tap: defined in src/hardware/gus.cpp. The same env-gated
+ * CSV trace captures both GUS (port 0x2xx range) and Adlib/OPL3 (0x388-0x38b)
+ * I/O so a single capture run covers both buses, time-sorted by ns. The log
+ * function early-returns when PICOGUS_TAP_FILE is unset; no overhead in the
+ * common case. State (FILE*, init flag) lives in gus.cpp; only the logger
+ * is shared. */
+extern void picogus_tap_log(const char* kind, Bitu port, Bitu val, Bitu iolen);
+
 static void OPL_CallBack(Bitu len) {
 	module->handler->Generate( module->mixerChan, len );
 	//Disable the sound generation after 30 seconds of silence
@@ -1365,7 +1373,15 @@ static Bitu OPL_Read(Bitu port,Bitu iolen) {
 	// help games that try to play digitized speech through the FM chip
 	if (!(port&1)) module->mixerChan->FillUp();
 
-	return module->PortRead( port, iolen );
+	Bitu _picogus_tap_ret = module->PortRead( port, iolen );
+
+	/* mdpicoem PicoGUS tap: log Adlib/OPL3 reads. Adlib registers with IO_MB
+	 * only, so iolen is 1 in practice (16-bit reads on 0x388 fall through to
+	 * IO_ReadSlowPath rather than reaching this handler), and PortRead does
+	 * not recurse -- no reentrancy guard needed. The logged value is the
+	 * post-read return so it correlates with what the guest CPU observed. */
+	picogus_tap_log(iolen == 2 ? "read16" : "read8", port, _picogus_tap_ret, iolen);
+	return _picogus_tap_ret;
 }
 
 pic_tickindex_t last_opl_write = 0;
@@ -1373,6 +1389,14 @@ pic_tickindex_t last_opl_write = 0;
 void OPL_Write(Bitu port,Bitu val,Bitu iolen) {
 	if (IS_PC98_ARCH) port >>= 8u; // C8D2h -> C8h, C9D2h -> C9h, OPL emulation looks only at bit 0.
 
+	/* mdpicoem PicoGUS tap: log Adlib/OPL3 writes. Logged after the PC98
+	 * port-shift so the value matches the OPL chip's view of the access
+	 * (mirroring the gus.cpp placement after the 0xFFF port mask). Adlib
+	 * registers with IO_MB only -> iolen is 1 in practice; the ternary
+	 * preserves the GUS hook's wider invariant in case the install mask
+	 * is ever widened. */
+	picogus_tap_log(iolen == 2 ? "write16" : "write8", port, val, iolen);
+
 	// if writing the data port, assume a change in OPL state that should be reflected immediately.
 	// this is a way to render "sample accurate" without needing "sample accurate" mode in the mixer.
 	// CHGOLF's Adlib digital audio hack works fine with this hack.
